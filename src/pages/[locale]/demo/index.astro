---
import DemoShell from '../../../layouts/DemoShell.astro';
import { getDemoManifest, getDemoPath } from '../../../lib/demo-manifest.mjs';
import { locales } from '../../../lib/home-renderer.mjs';

export function getStaticPaths() {
  return locales.map((entry) => {
    const locale = entry.path || 'en';
    return {
      params: { locale },
      props: { locale, hreflang: entry.hreflang }
    };
  });
}

function routeTopic(topic, locale, hreflang) {
  return {
    ...topic,
    locale,
    hreflang,
    canonicalPath: `/${locale}/guides/${topic.slug}/`,
    demoPath: getDemoPath(locale)
  };
}

const manifest = await getDemoManifest();
const { locale, hreflang } = Astro.props;
const localePack = manifest.localePublishPacks.find((pack) => pack.locale === locale) ??
  manifest.localePublishPacks.find((pack) => pack.locale === 'en');
if (!localePack) throw new Error(`Missing Demo content fallback: ${locale}`);
const topics = localePack.topics.map((topic) => routeTopic(topic, locale, hreflang));
const defaultTopic = topics[0];
const alternates = locales.map((entry) => ({
  hreflang: entry.hreflang,
  path: getDemoPath(entry.path || 'en')
}));
---

<DemoShell
  title="Foliole Demo"
  description={defaultTopic.description}
  topics={topics}
  topic={defaultTopic}
  runtime={manifest.runtime}
  canonicalPath={getDemoPath(locale)}
  alternates={alternates}
  xDefaultPath="/en/demo/"
  hreflang={hreflang}
  pageKind="website"
/>
