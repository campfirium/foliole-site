---
import DemoShell from '../../../layouts/DemoShell.astro';
import { getDemoManifest, getDemoPath } from '../../../lib/demo-manifest.mjs';
import { locales } from '../../../lib/home-renderer.mjs';

export async function getStaticPaths() {
  const manifest = await getDemoManifest();
  return locales.flatMap((entry) => {
    const locale = entry.path || 'en';
    const pack = manifest.localePublishPacks.find((candidate) => candidate.locale === locale) ??
      manifest.localePublishPacks.find((candidate) => candidate.locale === 'en');
    if (!pack) throw new Error(`Missing Guide content fallback: ${locale}`);
    return pack.topics.map((topic) => ({
      params: { locale, slug: topic.slug },
      props: { locale, hreflang: entry.hreflang, topic }
    }));
  });
}

const manifest = await getDemoManifest();
const { locale, hreflang, topic } = Astro.props;
const localePack = manifest.localePublishPacks.find((pack) => pack.locale === locale) ??
  manifest.localePublishPacks.find((pack) => pack.locale === 'en');
if (!localePack) throw new Error(`Missing Guide content fallback: ${locale}`);
const routeTopic = (entry) => ({
  ...entry,
  locale,
  hreflang,
  canonicalPath: `/${locale}/guides/${entry.slug}/`,
  demoPath: getDemoPath(locale)
});
const topics = localePack.topics.map(routeTopic);
const currentTopic = routeTopic(topic);
const alternates = locales.map((entry) => ({
  hreflang: entry.hreflang,
  path: `/${entry.path || 'en'}/guides/${topic.slug}/`
}));
---

<DemoShell
  title={currentTopic.title}
  description={currentTopic.description}
  topics={topics}
  topic={currentTopic}
  runtime={manifest.runtime}
  canonicalPath={currentTopic.canonicalPath}
  alternates={alternates}
  xDefaultPath={`/en/guides/${topic.slug}/`}
  hreflang={hreflang}
/>
